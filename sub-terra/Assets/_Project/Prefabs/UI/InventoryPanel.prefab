  m_text: "<color=#73F2FF><b>\uD654\uBB3C \uBB34\uAC8C \uC548\uB0B4</b></color>\n\u2022
    \uBB34\uAC8C\uAC00 \uBB34\uAC70\uC6B8\uC218\uB85D \uC774\uB3D9 \uC18D\uB3C4\uAC00
