  m_text: "\uD654\uBB3C \uBB34\uAC8C \uC548\uB0B4\n\u2022 \uBB34\uAC8C\uAC00 \uBB34\uAC70\uC6B8\uC218\uB85D
    \uC774\uB3D9 \uC18D\uB3C4\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\u2022 \uCD5C\uB300
    \uC801\uC7AC\uB7C9\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uB354 \uC774\uC0C1 \uC790\uC6D0\uC744
    \uCC44\uAD74\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\u2022 \uC801\uC7AC\uC728\uC5D0
