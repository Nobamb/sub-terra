--- !u!114 &4876191286684966592
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9062015555877298333}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uAE30\uBCF8 \uAC8C\uC784 \uC870\uC791\uBC95 (Controls Guide)\n\n\uCE90\uB9AD\uD130
    \uC774\uB3D9 \uBC0F \uC218\uC9C1 \uC774\uB3D9\n\xB7 \uC88C\uC6B0 \uC774\uB3D9:
    A / D \uD0A4 \uB610\uB294 \u2190 / \u2192 (\uBC29\uD5A5\uD0A4)\n\xB7 \uC0AC\uB2E4\uB9AC
    \uC774\uB3D9 / \uC218\uC9C1 \uD0D0\uC0AC: \uC0AC\uB2E4\uB9AC \uC704\uCE58\uC5D0\uC11C
    W / S \uD0A4 \uB610\uB294 \u2191 / \u2193 (\uBC29\uD5A5\uD0A4)\n\xB7 \uC5D8\uB9AC\uBCA0\uC774\uD130
    & \uC2DC\uC124 \uC0C1\uD638\uC791\uC6A9: E \uD0A4 (\uC9C0\uC0C1-\uC9C0\uD558
    \uC774\uB3D9 \uBC0F \uAE30\uC9C0 \uCF54\uC5B4 \uC0AC\uC6A9)\n\n\uC9C0\uD615 \uCC44\uAD74
    (Mining)\n\xB7 \uADFC\uC811 \uD0C0\uC77C \uCC44\uAD74: \uCC44\uAD74\uD558\uACE0\uC790
    \uD558\uB294 \uBE14\uB85D(\uC554\uBC18/\uAD11\uBB3C)\uC744 \uB9C8\uC6B0\uC2A4
    Left Click(\uC67C\uCABD \uD074\uB9AD) \uB610\uB294 Enter \uD0A4\n\xB7 \uD301:
    \uCE90\uB9AD\uD130 \uADFC\uCC98\uC758 \uC774\uC6C3\uD55C \uD0C0\uC77C\uB9CC \uCC44\uAD74
    \uAC00\uB2A5\uD558\uBA70, \uC5C5\uADF8\uB808\uC774\uB4DC\uC5D0 \uB530\uB77C \uCC44\uAD74
    \uC18D\uB3C4\uAC00 \uBE68\uB77C\uC9D1\uB2C8\uB2E4.\n\nUI \uBC0F \uAC74\uC124/\uAC00\uC774\uB4DC
    \uC870\uC791\n\xB7 \uC2DC\uC124 \uAC74\uC124 \uBA54\uB274: B \uD0A4 (\uAC74\uC124
    \uCC3D \uC5F4\uAE30/\uB2EB\uAE30)\n\xB7 \uD654\uBB3C/\uC778\uBCA4\uD1A0\uB9AC
    \uD655\uC778: I \uD0A4\n\xB7 Digger-Bot (\uB4DC\uB860) & \uD1B5\uD569 \uAC00\uC774\uB4DC
    \uCC3D: Tab \uD0A4 \uB610\uB294 \uD654\uBA74\uC758 Digger-Bot \uBC84\uD2BC \uD074\uB9AD\n\xB7
    \uAC8C\uC784 \uAC00\uC774\uB4DC: \uC6B0\uCE21 '\uAC8C\uC784 \uAC00\uC774\uB4DC'
    \uBC84\uD2BC"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 48b6c44ff06b5b84d81cbfcf3342d6f0, type: 2}
