  m_text: "\uC9C0\uC0C1\uC5D0\uB294 \uB354 \uC774\uC0C1 \uCE98 \uAC83\uC774 \uB0A8\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uBC30\uC591\uC2DC\uC124\uC5D0\uB294 \uC778\uB958\uC758
    \uC720\uC804 \uC815\uBCF4\uAC00 \uBCF4\uC874\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\n\uC720\uC804\uC790
    \uAC1C\uB7C9\uC5D0 \uC131\uACF5\uD558\uBA74, \uC778\uB958\uB97C \uB2E4\uC2DC
    \uD0DC\uC5B4\uB098\uAC8C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2DC\uC124\uC744
    \uAC00\uB3D9\uD560 \uC790\uC6D0\uC740 \uC774\uC81C \uB545 \uC544\uB798\uC5D0
    \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB0B4\uB824\uAC00\uC2ED\uC2DC\uC624. \uCE90\uACE0,
    \uBC84\uD2F0\uACE0, \uC0B4\uC544\uC11C \uB3CC\uC544\uC624\uC2ED\uC2DC\uC624."
